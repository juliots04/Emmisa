    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@quasar/vite-plugin": "^1.7.0",
    "@types/node": "^22.5.5",
    "@types/qrcode-generator": "^0.0.16",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.11.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.6.0",
