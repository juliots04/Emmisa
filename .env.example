# Copia este archivo a .env y llena los valores reales.
# El .env real NUNCA se sube a git (está en .gitignore).

# Supabase -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase -> Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# apisunat.com -> tu empresa -> Configuracion de Empresa -> API REST
APISUNAT_URL=
APISUNAT_PERSONA_ID=
APISUNAT_TOKEN=
