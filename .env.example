# Copia este archivo a .env y llena los valores reales.
# El .env real NUNCA se sube a git (esta en .gitignore).

# Supabase -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase -> Settings -> API -> service_role (secret) -- solo backend/Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# apisunat.com -> tu empresa -> Configuracion de Empresa -> API REST
APISUNAT_URL=
APISUNAT_PERSONA_ID=
APISUNAT_TOKEN=

# Modo SIMULADO de SUNAT (pruebas sin credenciales ni Edge Function).
# true = simula la emision localmente. Escenarios segun el nº de doc del cliente:
#        termina en 99 -> rechazado - 88 -> pendiente - resto -> aceptado.
VITE_SUNAT_SIMULADO=
